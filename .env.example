# Public market data does not need keys.
# Keys only for private/testnet trading later.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
BYBIT_DATA_HOST=public

# auto | always | never — fallback synthetic universe if Bybit unreachable
EDGEBOT_DEMO=auto
EDGEBOT_DATA_DIR=./data
EDGEBOT_CONFIG=./config/default.yaml
